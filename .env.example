# Application
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (SQLite by default; switch to PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Optional Redis + BullMQ (leave empty to use the built-in queue)
REDIS_URL=

# AI (OpenAI-compatible). Leave empty to use deterministic CV parsing/matching.
# Parsed fields are grounded against the CV text and never overwrite user edits.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000

# File storage (local by default)
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=
STORAGE_PUBLIC_URL=

# Limits
APPLICATION_MAX_PER_DAY=10
APPLICATION_MAX_EXECUTION_ATTEMPTS=3
JOB_SEARCH_INTERVAL_HOURS=6
MAX_UPLOAD_MB=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
QUEUE_STALE_LOCK_MS=300000

# Production requires a unique JWT_SECRET of 32+ characters.
# WORKER_SEPARATE=1 leaves the worker out of the API process.
